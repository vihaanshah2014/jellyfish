{
  "manifest_version": 3,
  "name": "Chess.com Stockfish Coach",
  "version": "1.0.0",
  "description": "Overlay Stockfish 11 best-move suggestions on chess.com boards.",
  "permissions": [
    "scripting"
  ],
  "host_permissions": [
    "https://www.chess.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.chess.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "engine/stockfish.js",
        "engine/stockfish.wasm",
        "overlay.css"
      ],
      "matches": [
        "https://www.chess.com/*"
      ]
    }
  ]
}
